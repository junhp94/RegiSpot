# Copy this file to server/.env and fill in your values.
# Never commit server/.env — it contains your database password.

# Neon pooled connection string (use the pooler endpoint, not the direct one)
DATABASE_URL=postgresql://user:password@ep-xxx.pooler.neon.tech/neondb?sslmode=require

# Any long random string — generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173
